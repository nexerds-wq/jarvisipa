<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleDisplayName</key><string>Solos Jarvis</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>NSBluetoothAlwaysUsageDescription</key><string>Find Solos glasses and inspect compatible accessory connections.</string>
<key>NSAppleMusicUsageDescription</key><string>Jarvis searches Apple Music and plays songs when you ask through voice controls.</string>
<key>NSMicrophoneUsageDescription</key><string>Listen for Hey Jarvis and questions on your iPhone.</string>
<key>NSSpeechRecognitionUsageDescription</key><string>Recognize Hey Jarvis and spoken questions with on-device speech processing.</string>
<key>NSLocationWhenInUseUsageDescription</key><string>Track your route while you navigate, including when the iPhone screen is locked, so the glasses can show updates and speak turns.</string>
<key>NSContactsUsageDescription</key><string>Show the contact name and profile photo on your Solos message HUD when you choose to share a message.</string>
<key>CFBundleURLTypes</key><array><dict>
<key>CFBundleURLName</key><string>com.nexer.solosjarvisbg.message</string>
<key>CFBundleURLSchemes</key><array><string>solosjarvis</string></array>
</dict></array>
<key>NSMotionUsageDescription</key><string>Count your daily steps using the iPhone's motion sensors.</string>
<key>UIBackgroundModes</key><array><string>bluetooth-central</string><string>external-accessory</string><string>location</string><string>audio</string></array>
<key>UISupportedExternalAccessoryProtocols</key><array>
<string>com.kopin.solos</string>
<string>com.solos.hud</string>
</array>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>NSHealthShareUsageDescription</key><string>Jarvis reads the latest available heart-rate sample from Apple Health to show it on your HUD.</string>
<key>NSLocalNetworkUsageDescription</key><string>Jarvis connects to the Ollama model on your local network when you enable online AI.</string>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict></plist>
